{
  "name": "jev-review",
  "version": "0.0.101",
  "description": "TypeSafe Jev approval review for Pi and DeepSeek Harness",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aimmetal-tech/jev-review.git"
  },
  "keywords": [
    "pi-package",
    "pi",
    "jev",
    "approval",
    "dsh-plugin",
    "deepseek-harness"
  ],
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs/RELEASING.md",
    "dist/dsh.js",
    "dsh"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "lint": "oxlint --deny-warnings src test scripts",
    "lint:fix": "oxlint --fix --deny-warnings src test scripts",
    "check": "tsc --noEmit",
    "test": "node --experimental-strip-types test/reviewer.test.ts && node --experimental-strip-types test/extension.test.ts && node --experimental-strip-types test/dsh.test.ts && node --experimental-strip-types test/dsh-native.test.ts && node --experimental-strip-types test/release.test.ts",
    "build": "esbuild src/dsh.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/dsh.js",
    "verify": "npm run lint && npm run check && npm test",
    "prepack": "npm run build",
    "check:package": "node --experimental-strip-types scripts/check-package.ts",
    "release:info": "node --experimental-strip-types scripts/release-info.ts"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.4 || 4.0.5-alpha.1",
    "@deepseek-ai/dsh-experimental-auto-review": "0.2.0-rc.2 || 0.2.1-alpha.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2 || 0.2.1-alpha.2",
    "@earendil-works/pi-coding-agent": "*",
    "@mariozechner/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@mariozechner/pi-coding-agent": {
      "optional": true
    },
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-experimental-auto-review": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5-alpha.1",
    "@deepseek-ai/dsh-agent": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-experimental-auto-review": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-llm": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-permission-presets": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-session": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-session-projection": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-tools": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-user-approval": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-working-directory": "0.2.1-alpha.2",
    "@deepseek-ai/schemastery": "3.18.5-alpha.1",
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@types/node": "^22.19.0",
    "esbuild": "^0.27.4",
    "oxlint": "1.87.0",
    "typescript": "~5.9.3"
  },
  "exports": {
    "./dsh": "./dist/dsh.js",
    "./dsh/locale/*.json": "./dsh/locale/*.json",
    "./dsh/icon": "./dsh/icon.svg",
    "./dsh/cordis.patch.yml": "./dsh/cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./dsh/locale/*.json",
    "./icon": "./dsh/icon.svg"
  },
  "dsh": {
    "bundle": {
      "patch": "./dsh/cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4 || 3.18.5-alpha.1"
  },
  "icon": "./dsh/icon.svg",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
